---

<section id="productos" class="seccion-productos">
  <h2 class="titulo-seccion oculto">Nuestros Favoritos</h2>

  <div class="cuadricula-productos">
    {
      productos.map((prod) => (
        <div class="tarjeta-producto oculto">
          <img src={prod.img} alt={prod.nombre} class="imagen-producto" />
          <div class="informacion">
            <h3>{prod.nombre}</h3>
            <p class="precio">{prod.precio}</p>
          </div>
        </div>
      ))
    }
  </div>
</section>
