---
import "../styles/contacto.css";
---

<section id="contacto" class="seccion-contacto">
    <div class="contenedor-contacto">
        <h2 class="titulo-seccion oculto">Visítanos y Contáctanos</h2>

        <div class="cuadricula-contacto">
            <!-- Info de contacto -->
            <div class="caja-informacion oculto">
                <div class="elemento-informacion">
                    <div class="icono">📍</div>
                    <div>
                        <h3>Ubicación</h3>
                        <p>
                            <strong>Sede Principal:</strong> Calle Gran Vía, 48<br />28013 Madrid, España
                        </p>
                        <p>
                            <strong>Ubicación Alternativa:</strong> Calle del Café, 12<br />28004 Madrid, España
                        </p>
                    </div>
                </div>

                <div class="elemento-informacion">
                    <div class="icono">📞</div>
                    <div>
                        <h3>Teléfono</h3>
                        <p>
                            <strong>Principal:</strong> <a href="tel:+34912345678">+34 912 345 678</a><br />
                            <strong>Alternativo / WhatsApp:</strong> <a href="tel:+34612987654">+34 612 987 654</a><br />
                            Lun - Dom: 08:00 - 20:00
                        </p>
                    </div>
                </div>

                <div class="elemento-informacion">
                    <div class="icono">✉️</div>
                    <div>
                        <h3>Email</h3>
                        <p>
                            <strong>General:</strong> <a href="mailto:hola@sundaytable.com">hola@sundaytable.com</a><br />
                            <strong>Alternativo / Reservas:</strong> <a href="mailto:reservas@sundaytable.com">reservas@sundaytable.com</a>
                        </p>
                    </div>
                </div>

                <div class="redes-sociales">
                    <h4>Conecta con Nosotros</h4>
                    <div class="iconos-redes">
                        <a href="https://instagram.com" target="_blank" rel="noopener noreferrer" class="red-social" aria-label="Instagram">📸</a>
                        <a href="https://facebook.com" target="_blank" rel="noopener noreferrer" class="red-social" aria-label="Facebook">📘</a>
                        <a href="https://twitter.com" target="_blank" rel="noopener noreferrer" class="red-social" aria-label="Twitter">🐦</a>
                    </div>
                </div>
            </div>

            <!-- Horarios -->
            <div class="caja-horarios oculto">
                <h3>Horarios de Apertura</h3>
                <div class="elemento-horario">
                    <span class="dia">Lunes - Viernes</span>
                    <span class="hora">08:00 - 20:00</span>
                </div>
                <div class="elemento-horario">
                    <span class="dia">Sábados</span>
                    <span class="hora">09:00 - 21:00</span>
                </div>
                <div class="elemento-horario">
                    <span class="dia">Domingos</span>
                    <span class="hora">09:30 - 19:00 (Sunday Brunch Especial)</span>
                </div>
                <div class="elemento-horario">
                    <span class="dia">Festivos</span>
                    <span class="hora">10:00 - 18:00</span>
                </div>
            </div>
        </div>
    </div>
</section>
